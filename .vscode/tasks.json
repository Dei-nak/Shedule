{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Розклад: живий перегляд",
      "type": "process",
      "command": "node",
      "args": [
        "--watch",
        "server.cjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "4173"
        }
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
